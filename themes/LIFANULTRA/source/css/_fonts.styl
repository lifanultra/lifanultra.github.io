// 中文字体限定字符范围，英文、数字和其他西文始终交给 Times New Roman。
@font-face
  font-family: "Document FangSong"
  src: local("仿宋_GB2312"), local("FangSong_GB2312"), local("FangSong"), local("仿宋"), local("STFangsong"), local("华文仿宋")
  font-display: swap
  unicode-range: U+2E80-2FFF, U+3000-303F, U+3100-312F, U+31A0-31EF, U+3200-33FF, U+3400-4DBF, U+4E00-9FFF, U+F900-FAFF, U+FE10-FE1F, U+FE30-FE4F, U+FF00-FFEF, U+20000-2FA1F, U+30000-323AF

