<footer id="footer">
  <div class="footer-theme">
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换为白天模式" aria-pressed="true" hidden>
      <span class="theme-choice-light" aria-hidden="true">浅色</span>
      <span class="theme-choice-divider" aria-hidden="true">/</span>
      <span class="theme-choice-dark" aria-hidden="true">深色</span>
    </button>
  </div>
  <div class="footer-left">
    <%= __('footer.copyright') %> &copy;
    <% var endYear = (theme.copyright && theme.copyright.end_year) ? theme.copyright.end_year : new Date().getFullYear() %>
    <% var startYear = (theme.copyright && theme.copyright.start_year) ? theme.copyright.start_year : new Date().getFullYear() %>
    <%= startYear >= endYear ? endYear : startYear + "-" + endYear %>
    <%= (theme.copyright && theme.copyright.owner) || config.author || config.title %>
  </div>
  <div class="footer-right">
    <nav>
      <ul>
        <% for (var i in theme.nav) { %><!--
       --><li><a href="<%- url_for(theme.nav[i]) %>"><%= __('nav.'+i).replace("nav.", "") %></a></li><!--
     --><% } %>
      </ul>
    </nav>
  </div>
</footer>
